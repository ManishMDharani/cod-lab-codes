
module tb_instruction_fetch;

    logic clk;
    logic reset;
    logic stall;
    logic redirect_valid;

    logic [31:0] redirect_pc;
    logic [31:0] pc_out;
    logic [31:0] instruction;

    instruction_fetch DUT (
        .clk(clk),
        .reset(reset),
        .stall(stall),
        .redirect_valid(redirect_valid),
        .redirect_pc(redirect_pc),
        .pc_out(pc_out),
        .instruction(instruction)
    );
    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    initial begin

        reset = 1;
        stall = 0;
        redirect_valid = 0;
        redirect_pc = 0;

        #12;
        reset = 0;
        #30;
        stall = 1;
        #20;
        stall = 0;
        redirect_valid = 1;
        redirect_pc = 32'h00000010;
        #10;
        redirect_valid = 0;

        #30;

        $finish;
    end
    initial begin
        $monitor(
            "Time=%0t | PC=%h | Instruction=%h",
            $time, pc_out, instruction
        );
    end

endmodule
